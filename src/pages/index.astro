---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import EntryRow from "@components/EntryRow.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const blog = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects: CollectionEntry<"projects">[] = (
  await getCollection("projects")
)
  .filter((project) => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const now = [
  "an e-commerce build on Medusa",
  "an internet audio player for my son",
  "a browser extension that scores car deals",
];
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <div data-pagefind-ignore class="space-y-16">
      <section class="animate space-y-5">
        <p class="text-[13px]">
          <span class="text-amber">$</span> whoami
        </p>

        <h1
          class="text-[1.6rem] leading-[1.35] font-semibold tracking-tight text-silk sm:text-[1.9rem]"
        >
          I build weirdly useful things with Next.js, .NET, Python, ESP32s and
          Pi Zeros. Usually self-hosted. Always <span class="text-amber"
            >over-engineered</span
          >.<span class="cursor ml-1.5" aria-hidden="true"></span>
        </h1>

        <p class="max-w-[60ch] font-sans text-[0.95rem] leading-relaxed">
          I write about what works, what breaks, what nearly caught fire, and
          what somehow got fixed in prod — deep dives on web tech, embedded
          systems, machine learning and a homelab that keeps growing.
        </p>
      </section>

      <section class="animate space-y-4">
        <h2 class="label"><span class="label-sigil">$</span> cat now</h2>
        <ul class="space-y-1.5 text-[0.9rem]">
          {
            now.map((item) => (
              <li class="flex gap-3">
                <span class="select-none opacity-45">—</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-4">
        <div class="flex items-baseline gap-4">
          <h2 class="label flex-1">
            <span class="label-sigil">$</span> ls posts
          </h2>
          <a
            href="/blog"
            class="shrink-0 text-[13px] no-underline transition-colors hover:text-amber"
            >all &rarr;</a
          >
        </div>
        <ul class="not-prose">
          {blog.map((post) => <li><EntryRow entry={post} full /></li>)}
        </ul>
      </section>

      {
        projects.length > 0 && (
          <section class="animate space-y-4">
            <div class="flex items-baseline gap-4">
              <h2 class="label flex-1">
                <span class="label-sigil">$</span> ls projects
              </h2>
              <a
                href="/projects"
                class="shrink-0 text-[13px] no-underline transition-colors hover:text-amber"
              >
                all &rarr;
              </a>
            </div>
            <ul class="not-prose">
              {projects.map((project) => (
                <li>
                  <EntryRow entry={project} full />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="animate space-y-4">
        <h2 class="label"><span class="label-sigil">$</span> cat contact</h2>
        <p class="max-w-[60ch] font-sans text-[0.95rem]">
          Reach out if you want to talk about any of this, or just to say hi.
        </p>
        <ul class="not-prose flex flex-wrap gap-x-6 gap-y-2 text-[0.9rem]">
          {
            SOCIALS.map((social) => (
              <li>
                <a
                  href={social.HREF}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="no-underline transition-colors hover:text-amber"
                  aria-label={`${SITE.TITLE} on ${social.NAME}`}
                >
                  {social.NAME.toLowerCase()}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href={`mailto:${SITE.EMAIL}`}
              class="no-underline transition-colors hover:text-amber"
              >{SITE.EMAIL}</a
            >
          </li>
        </ul>
      </section>
    </div>
  </Container>
</Layout>
