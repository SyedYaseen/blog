---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import EntryRow from "@components/EntryRow.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import { getTagGroups } from "@lib/tags";

export async function getStaticPaths() {
  const groups = await getTagGroups();

  return groups.map((group) => ({
    params: { id: group.slug },
    props: { label: group.label, entries: group.entries },
  }));
}

const { label, entries } = Astro.props;
---

<Layout title={`Tagged ${label}`} description={`Posts tagged ${label}.`}>
  <Container>
    <div data-pagefind-ignore class="space-y-10">
      <div class="animate">
        <BackToPrevious href="/tags">All tags</BackToPrevious>
      </div>
      <header class="animate space-y-2">
        <h1 class="text-xl font-semibold tracking-tight text-silk">
          <span class="text-amber">#</span>{label}
        </h1>
        <p class="text-[13px]">
          {entries.length}
          {entries.length === 1 ? "entry" : "entries"}
        </p>
      </header>
      <ul class="animate not-prose">
        {entries.map((entry) => <li><EntryRow entry={entry} full /></li>)}
      </ul>
    </div>
  </Container>
</Layout>
