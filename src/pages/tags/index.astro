---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { TAGS } from "@consts";
import { getTagGroups } from "@lib/tags";

const tags = await getTagGroups();
---

<Layout title={TAGS.TITLE} description={TAGS.DESCRIPTION}>
  <Container>
    <div data-pagefind-ignore class="space-y-10">
      <header class="animate space-y-3">
        <h1 class="text-xl font-semibold tracking-tight text-silk">Tags</h1>
        <p class="max-w-[62ch] font-sans text-[0.95rem]">{TAGS.DESCRIPTION}</p>
      </header>

      <ul class="animate not-prose flex flex-wrap gap-2">
        {
          tags.map(({ slug, label, entries }) => (
            <li>
              <a href={`/tags/${slug}`} class="chip">
                {label}
                <span class="tabular-nums opacity-60">{entries.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Layout>
