---
const { prevPost, nextPost } = Astro.props;
---

{
  (prevPost?.id || nextPost?.id) && (
    <nav class="grid gap-px border-y border-rule sm:grid-cols-2" aria-label="More posts">
      {prevPost?.id ? (
        <a
          href={`/blog/${prevPost.id}`}
          class="group flex flex-col gap-1 py-4 no-underline sm:pr-6"
        >
          <span class="text-[12px]">&larr; newer</span>
          <span class="text-[0.9rem] text-silk transition-colors group-hover:text-amber">
            {prevPost.data.title}
          </span>
        </a>
      ) : (
        <div class="hidden sm:block" />
      )}

      {nextPost?.id && (
        <a
          href={`/blog/${nextPost.id}`}
          class="group flex flex-col gap-1 border-t border-rule py-4 no-underline sm:items-end sm:border-t-0 sm:border-l sm:pl-6"
        >
          <span class="text-[12px]">older &rarr;</span>
          <span class="text-[0.9rem] text-silk transition-colors group-hover:text-amber sm:text-right">
            {nextPost.data.title}
          </span>
        </a>
      )}
    </nav>
  )
}
