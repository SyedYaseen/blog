---
import Container from "@components/Container.astro";
import { SITE } from "@consts";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);

const nav = [
  { href: "/blog", label: "blog" },
  { href: "/projects", label: "projects" },
  { href: "/tags", label: "tags" },
];
---

<header class="site-header" data-pagefind-ignore transition:persist>
  <Container>
    <div class="flex items-center justify-between gap-4">
      <a
        href="/"
        class="flex items-center gap-2 text-silk no-underline"
        aria-label={`${SITE.TITLE} — home`}
      >
        <span class="cursor" aria-hidden="true"></span>
        <span class="font-semibold tracking-tight">{SITE.TITLE.toLowerCase()}</span>
      </a>

      <nav class="flex items-center gap-4 text-[13px]">
        {
          nav.map((item) => (
            <a
              href={item.href}
              class:list={[
                "no-underline transition-colors hover:text-amber",
                isActive(item.href) ? "text-silk" : "text-muted",
              ]}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <button
          id="magnifying-glass"
          aria-label="Search"
          class="flex items-center gap-1.5 border border-rule px-2 py-1 text-[12px] text-muted transition-colors hover:border-amber hover:text-amber"
        >
          <svg
            height="13"
            width="13"
            viewBox="0 0 16 16"
            aria-hidden="true"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M3.5 7C3.5 5.067 5.067 3.5 7 3.5C8.933 3.5 10.5 5.067 10.5 7C10.5 7.88461 10.1718 8.69256 9.63058 9.30876L9.30876 9.63058C8.69256 10.1718 7.88461 10.5 7 10.5C5.067 10.5 3.5 8.933 3.5 7ZM9.96544 11.0261C9.13578 11.6382 8.11014 12 7 12C4.23858 12 2 9.76142 2 7C2 4.23858 4.23858 2 7 2C9.76142 2 12 4.23858 12 7C12 8.11014 11.6382 9.13578 11.0261 9.96544L14.0303 12.9697L14.5607 13.5L13.5 14.5607L12.9697 14.0303L9.96544 11.0261Z"
            ></path>
          </svg>
          <kbd class="hidden font-mono sm:inline">/</kbd>
        </button>
      </nav>
    </div>
  </Container>
</header>
