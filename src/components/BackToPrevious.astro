---
type Props = { href: string };
const { href } = Astro.props;
---

<a
  href={href}
  class="group inline-flex w-fit items-center gap-2 text-[13px] no-underline transition-colors hover:text-amber"
>
  <span
    class="transition-transform group-hover:-translate-x-0.5"
    aria-hidden="true">&larr;</span
  >
  <slot />
</a>
