---
import Container from "@components/Container.astro";
import { SITE, SOCIALS } from "@consts";
---

<footer class="animate border-t border-rule py-8 text-[13px]" data-pagefind-ignore>
  <Container>
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
      <span>&copy; {new Date().getFullYear()} {SITE.TITLE}</span>
      <nav class="flex flex-wrap items-center gap-x-4 gap-y-2">
        {
          SOCIALS.map((social) => (
            <a
              href={social.HREF}
              target="_blank"
              rel="noopener noreferrer"
              class="no-underline transition-colors hover:text-amber"
            >
              {social.NAME.toLowerCase()}
            </a>
          ))
        }
        <a
          href={`mailto:${SITE.EMAIL}`}
          class="no-underline transition-colors hover:text-amber">email</a
        >
        <a href="/rss.xml" class="no-underline transition-colors hover:text-amber"
          >rss</a
        >
      </nav>
    </div>
  </Container>
</footer>
